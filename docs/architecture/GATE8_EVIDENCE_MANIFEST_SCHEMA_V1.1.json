{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tio2malaysia.com/internal/schemas/gate8-evidence-manifest-v1.1.json",
  "title": "Gate8 Static Artifact Evidence Manifest V1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "handoff_id",
    "gate8_task_id",
    "receipt_path",
    "pages",
    "git",
    "build",
    "runtime",
    "evidence",
    "receipt_evidence_references",
    "known_open_items"
  ],
  "properties": {
    "schema_version": {
      "const": "gate8-evidence-manifest-v1.1"
    },
    "handoff_id": {
      "type": "string",
      "minLength": 1
    },
    "gate8_task_id": {
      "type": "string",
      "minLength": 1
    },
    "receipt_path": {
      "type": "string",
      "minLength": 1
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "page_id",
          "acceptance_condition_ids",
          "runtime_path"
        ],
        "properties": {
          "page_id": {
            "type": "string",
            "minLength": 1
          },
          "acceptance_condition_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "runtime_path": {
            "type": "string",
            "pattern": "^/"
          }
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "baseline_commit",
        "implementation_commit",
        "evidence_head"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "baseline_commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "implementation_commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "evidence_head": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directory",
        "implementation_commit",
        "files",
        "binding_evidence"
      ],
      "properties": {
        "directory": {
          "type": "string",
          "minLength": 1
        },
        "implementation_commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "binding_evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_url",
        "environment_type",
        "started_at",
        "hold_until",
        "checks"
      ],
      "properties": {
        "base_url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "environment_type": {
          "type": "string",
          "enum": [
            "local-production",
            "local-preview",
            "staging",
            "production"
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "hold_until": {
          "const": "GATE9_PASS_OR_RETURN_NOTICE"
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "expected_status",
              "contains",
              "artifact_path"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^/"
              },
              "expected_status": {
                "type": "integer",
                "minimum": 100,
                "maximum": 599
              },
              "contains": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "artifact_path": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "evidence_type",
          "proves",
          "command",
          "environment"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "evidence_type": {
            "type": "string",
            "enum": [
              "ACTUAL_RUNTIME",
              "STATIC_VISUAL",
              "SOURCE_INSPECTION",
              "LOCAL_SIMULATION",
              "TEST_RESULT",
              "IDENTITY",
              "RECEIVER"
            ]
          },
          "proves": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "environment": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "receipt_evidence_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "known_open_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "owner",
          "blocking_layer",
          "closure_evidence",
          "closure_timing"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "blocking_layer": {
            "type": "string",
            "enum": [
              "RECHECK_SCOPE",
              "PAGE_GATE9",
              "INTEGRATION",
              "RELEASE"
            ]
          },
          "closure_evidence": {
            "type": "string",
            "minLength": 1
          },
          "closure_timing": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
