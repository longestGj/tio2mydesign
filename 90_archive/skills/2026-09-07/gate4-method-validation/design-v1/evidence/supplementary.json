          "fontSize": "20px",
          "scrollWidth": 180,
          "clientWidth": 180
        },
        {
          "tag": "TD",
          "text": "Dilute dispersion; measurement made after the stated preparation sequence, without converting to a dry sample percentage.",
          "fontSize": "16px",
          "scrollWidth": 360,
          "clientWidth": 360
        },
        {
          "tag": "TD",
          "text": "B — Preserve the unit and preparation condition when copying this result into an evaluation note.",
          "fontSize": "16px",
          "scrollWidth": 360,
          "clientWidth": 360
        },
        {
          "tag": "TH",
          "text": "Sample Gamma — assessment reference",
          "fontSize": "16px",
          "scrollWidth": 300,
          "clientWidth": 300
        },
        {
          "tag": "TD",
          "text": "12–18 µm",
          "fontSize": "20px",
          "scrollWidth": 180,
          "clientWidth": 180
        },
        {
          "tag": "TD",
          "text": "Observed interval across the prepared sample; the interval is not a guaranteed production tolerance.",
          "fontSize": "16px",
          "scrollWidth": 360,
          "clientWidth": 360
        },
        {
          "tag": "TD",
          "text": "C — The endpoints describe the observed sample interval only.",
          "fontSize": "16px",
          "scrollWidth": 360,
          "clientWidth": 360
        },
